CHIP_FAMILY = bao1x
LONGINT_IMPL = MPZ
INTERNAL_LIBM = 1

# REPL on USB CDC, CIRCUITPY as a USB drive held in SRAM. RRAM is written
# only by baochip.save().
#
# A full build, with the hardware modules the port lacks switched off below.
CIRCUITPY_FULL_BUILD = 1
CIRCUITPY_USB_DEVICE = 1
CIRCUITPY_USB_CDC = 1
CIRCUITPY_USB_MSC = 1
CIRCUITPY_USB_HID = 0
CIRCUITPY_USB_MIDI = 0
USB_NUM_ENDPOINT_PAIRS = 5

# The header UART belongs to the program. A build without USB, or one made
# with BAOCHIP_UART_CONSOLE=1, puts a REPL on UART2 as well.
BAOCHIP_UART_CONSOLE ?= 0
ifeq ($(CIRCUITPY_USB_DEVICE),0)
CIRCUITPY_PORT_SERIAL = 1
else ifeq ($(BAOCHIP_UART_CONSOLE),1)
CIRCUITPY_PORT_SERIAL = 1
else
CIRCUITPY_PORT_SERIAL = 0
endif
INTERNAL_FLASH_FILESYSTEM = 1

# Implemented by this port.
CIRCUITPY_MICROCONTROLLER = 1
CIRCUITPY_BOARD = 1
CIRCUITPY_DIGITALIO = 1
CIRCUITPY_ANALOGIO = 1
CIRCUITPY_BUSIO = 1
CIRCUITPY_BUSDEVICE = 1
CIRCUITPY_PWMIO = 1
CIRCUITPY_OS = 1
CIRCUITPY_STORAGE = 1
CIRCUITPY_SUPERVISOR = 1

# Software modules.
CIRCUITPY_ARRAY = 1
CIRCUITPY_BINASCII = 1
CIRCUITPY_COLLECTIONS = 1
CIRCUITPY_ERRNO = 1
CIRCUITPY_IO = 1
CIRCUITPY_JSON = 1
CIRCUITPY_MATH = 1
CIRCUITPY_RANDOM = 1
CIRCUITPY_RE = 1
CIRCUITPY_STRUCT = 1
CIRCUITPY_SYS = 1
CIRCUITPY_TIME = 1
CIRCUITPY_TRACEBACK = 1
CIRCUITPY_ZLIB = 1
MICROPY_PY_ASYNC_AWAIT = 1

# On the chip's crypto engine.
CIRCUITPY_AESIO = 1
CIRCUITPY_HASHLIB = 1
CIRCUITPY_HASHLIB_MBEDTLS = 0

# Not implemented.
CIRCUITPY_AUDIOBUSIO = 0
CIRCUITPY_AUDIOIO = 0
CIRCUITPY_AUDIOCORE = 0
CIRCUITPY_AUDIOMIXER = 0
CIRCUITPY_AUDIOMP3 = 0
CIRCUITPY_AUDIOPWMIO = 0
CIRCUITPY_SYNTHIO = 0
CIRCUITPY_BITBANGIO = 0
CIRCUITPY_BITMAPTOOLS = 0
CIRCUITPY_BLEIO_HCI = 0
CIRCUITPY_COUNTIO = 0
CIRCUITPY_DISPLAYIO = 0
CIRCUITPY_FRAMEBUFFERIO = 0
CIRCUITPY_FREQUENCYIO = 0
CIRCUITPY_I2CTARGET = 0
CIRCUITPY_KEYPAD = 0
CIRCUITPY_MSGPACK = 0
CIRCUITPY_NEOPIXEL_WRITE = 0
CIRCUITPY_NVM = 0
CIRCUITPY_ONEWIREIO = 0
CIRCUITPY_PARALLELDISPLAYBUS = 0
CIRCUITPY_PIXELBUF = 0
CIRCUITPY_PULSEIO = 0
CIRCUITPY_RAINBOWIO = 0
CIRCUITPY_ROTARYIO = 0
CIRCUITPY_RTC = 0
CIRCUITPY_SAFEMODE_PY = 0
CIRCUITPY_SDCARDIO = 0
